<Layout Path="/roundups/" TitleKey="roundups.title">
    <h1><T K="roundups.title" /></h1>
    <p class="lead"><T K="roundups.intro" /> <a href="/roundups/feed.xml"><T K="roundups.rss" /></a></p>

    @if (Site.Roundups.Count == 0)
    {
        <p class="note"><T K="roundups.none" /></p>
    }
    else
    {
        <ol class="roundups">
            @foreach (var r in Site.Roundups)
            {
                <li>
                    <time datetime="@r.Date.ToString("yyyy-MM-dd")">@r.Date.ToString("yyyy-MM-dd")</time>
                    @foreach (var (lang, text) in new[] { ("ka", r.Ka), ("en", r.En) })
                    {
                        <span class="l10n" lang="@lang">
                            <a href="/roundups/@r.Slug/">@text.Title</a>
                            @if (text.Summary is not null)
                            {
                                <p>@text.Summary</p>
                            }
                        </span>
                    }
                </li>
            }
        </ol>
    }
</Layout>
