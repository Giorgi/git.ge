@* A developer's (or organization's) page: their projects plus what only git.ge
   can show: category ranks, Spotlight weeks and roundups, who among git.ge
   developers they follow and who follows them, and contributions between git.ge
   projects. Empty sections are left out. See docs/specs/developer-pages.md. *@
<Layout Path="@D.Path" Title="@PageTitle" Description="@Summary" OgType="profile"
        Crumbs="@Crumbs" JsonLd="@(new object[] { Seo.Profile(D) })">
    <article class="dev">
        <header class="dev-head">
            <Avatar Login="@D.Login" Size="96" />
            <div class="dev-id">
                <h1>@D.DisplayName</h1>
                <p class="dev-login">
                    <a href="@D.Url">github.com/@D.Login</a> ·
                    <T K="@(D.IsOrg ? "dev.org" : "dev.person")" />
                </p>
                <p class="dev-summary">
                    <T K="dev.projectCount" Args="@([Format.Number(D.Projects.Count + D.Smaller.Count)])" /> ·
                    @Format.Number(D.Stars) <Stars />
                    @if (D.Languages.Count > 0)
                    {
                        <span> · @string.Join(", ", D.Languages)</span>
                    }
                    @foreach (var cat in D.Categories)
                    {
                        <span> · </span><a href="/c/@cat/"><T K="@($"cat.{cat}")" /></a>
                    }
                </p>
                @if (D.Spotlight.Count > 0 || D.Roundups.Count > 0)
                {
                    <ul class="chips">
                        @foreach (var week in D.Spotlight)
                        {
                            @* Both languages, CSS shows one: the dates have month names. *@
                            <li class="chip">@foreach (var (lang, s) in Langs)
                                {<span class="l10n" lang="@lang">@s["dev.spotlight"].Replace("{0}", Format.WeekText(week, s))</span>}</li>
                        }
                        @foreach (var slug in D.Roundups)
                        {
                            <li class="chip"><a href="/roundups/@slug/">@foreach (var (lang, s) in Langs)
                                {<span class="l10n" lang="@lang">@s["dev.roundup"].Replace("{0}", Format.MonthText(slug, s))</span>}</a></li>
                        }
                    </ul>
                }
            </div>
            @* Shown by app.js: the share sheet on touch devices, otherwise copies the link. *@
            <div class="dev-share">
                <button type="button" class="btn" hidden data-share>
                    <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" focusable="false" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M12 3.5v11M7.75 7.75 12 3.5l4.25 4.25M5.5 12.5v5.75c0 .97.78 1.75 1.75 1.75h9.5c.97 0 1.75-.78 1.75-1.75V12.5" />
                    </svg>
                    <T K="dev.share" />
                </button>
                <span class="dev-share-status" role="status" data-share-status></span>
            </div>
        </header>

        @* Below the header (not beside the avatar), so the sentences get the full width on phones.
           The best TopRanks lead in a larger size; the rest wait behind "კიდევ N". *@
        @if (D.Ranks.Count > 0)
        {
            <section class="dev-ranks" aria-labelledby="dev-ranks">
                <h2 id="dev-ranks"><T K="dev.ranking" /></h2>
                <ul class="dev-ranks-top">
                    @foreach (var r in D.Ranks.Take(TopRanks))
                    {
                        <li><RankLine R="r" Strong="true" /></li>
                    }
                </ul>
                @if (D.Ranks.Count > TopRanks)
                {
                    var more = D.Ranks.Count - TopRanks;
                    <details class="dev-ranks-more">
                        <summary><T K="@(more == 1 ? "dev.moreRanksOne" : "dev.moreRanks")" Args="@([more])" /></summary>
                        <ul>
                            @foreach (var r in D.Ranks.Skip(TopRanks))
                            {
                                <li><RankLine R="r" /></li>
                            }
                        </ul>
                    </details>
                }
            </section>
        }

        @if (D.Mutual.Count > 0 || D.FollowedBy.Count > 0 || D.Follows.Count > 0)
        {
            <section class="dev-social" aria-labelledby="dev-social">
                <h2 id="dev-social" class="dev-social-title"><T K="dev.socialLabel" /></h2>
                <PeopleRow Logins="@D.Mutual" TextKey="dev.mutual" />
                <PeopleRow Logins="@D.FollowedBy" TextKey="dev.followedBy" />
                <PeopleRow Logins="@D.Follows" TextKey="dev.follows" />
            </section>
        }

        <div class="dev-cols">
            <section aria-labelledby="dev-projects">
                <h2 id="dev-projects"><T K="dev.projects" /></h2>
                @if (D.Projects.Count > 0)
                {
                    <ProjectList Items="@D.Projects.Select(Site.Project)" ShowOwner="false" />
                    @if (D.Smaller.Count > 0)
                    {
                        <details class="dev-smaller">
                            <summary><T K="dev.smaller" Args="@([D.Smaller.Count])" /></summary>
                            <ProjectList Items="@D.Smaller.Select(Site.Project)" ShowOwner="false" />
                        </details>
                    }
                }
                else
                {
                    @* Only search-only projects: show them directly. *@
                    <ProjectList Items="@D.Smaller.Select(Site.Project)" ShowOwner="false" />
                }
            </section>

            @if (D.ContributesTo.Count > 0 || D.Contributors.Count > 0 || Issues.Count > 0)
            {
                <aside class="dev-side">
                    @if (D.ContributesTo.Count > 0)
                    {
                        <section aria-labelledby="dev-contributes">
                            <h2 id="dev-contributes"><T K="dev.contributesTo" /></h2>
                            <ul class="rows">
                                @foreach (var c in D.ContributesTo)
                                {
                                    var project = Site.Project(c.Project);
                                    <li class="row">
                                        <a class="row-avatar" href="@Site.OwnerHref(project.Owner)" title="@(Site.Developer(project.Owner)?.DisplayName ?? project.Owner)" aria-hidden="true" tabindex="-1"><Avatar Login="@project.Owner" Size="24" /></a>
                                        <span class="row-main"><a class="p-owner" href="@Site.OwnerHref(project.Owner)">@(project.Owner)/</a><a href="@project.Url" rel="@(project.IsSubmittedUrl ? "nofollow ugc" : null)">@project.Name</a></span>
                                        <span class="row-note"><T K="@(c.Commits == 1 ? "dev.commitsOne" : "dev.commits")" Args="@([c.Commits])" /></span>
                                    </li>
                                }
                            </ul>
                        </section>
                    }
                    @if (D.Contributors.Count > 0)
                    {
                        <section aria-labelledby="dev-contributors">
                            <h2 id="dev-contributors"><T K="dev.contributors" /></h2>
                            <ul class="rows">
                                @foreach (var c in D.Contributors)
                                {
                                    <li class="row">
                                        <a class="row-avatar" href="@Site.OwnerHref(c.Login)" aria-hidden="true" tabindex="-1"><Avatar Login="@c.Login" Size="24" /></a>
                                        <span class="row-main"><a href="@Site.OwnerHref(c.Login)">@(Site.Developer(c.Login)?.DisplayName ?? c.Login)</a></span>
                                        <span class="row-note"><T K="@(c.Commits == 1 ? "dev.commitsOne" : "dev.commits")" Args="@([c.Commits])" /></span>
                                    </li>
                                }
                            </ul>
                        </section>
                    }
                    @if (Issues.Count > 0)
                    {
                        <section aria-labelledby="dev-hw">
                            <h2 id="dev-hw"><T K="hw.title" /></h2>
                            <ul class="rows">
                                @foreach (var issue in Issues.Take(MaxIssues))
                                {
                                    <li class="row">
                                        <span class="row-main"><a href="@issue.Url">@issue.Title</a></span>
                                        <span class="row-note" title="@Site.Project(issue.Project).Name">@Site.Project(issue.Project).Name</span>
                                    </li>
                                }
                            </ul>
                            @if (Issues.Count > MaxIssues)
                            {
                                <p class="more"><a href="/help-wanted/#@Site.Project(Issues[0].Project).Anchor"><T K="dev.allIssues" Args="@([Issues.Count])" /></a></p>
                            }
                        </section>
                    }
                </aside>
            }
        </div>
    </article>
</Layout>

@code {
    const int MaxIssues = 5;
    const int TopRanks = 2;

    static (string Lang, Dictionary<string, string> Strings)[] Langs => [("ka", Site.Strings.Georgian), ("en", Site.Strings.English)];

    [Parameter, EditorRequired] public SiteDeveloper D { get; set; } = default!;

    List<HelpWantedIssue> Issues =>
        Site.Data.Issues.Where(i => D.Projects.Contains(i.Project) || D.Smaller.Contains(i.Project))
            .OrderByDescending(i => i.CreatedAt).ToList();

    // e.g. "Giorgi Dalakishvili (@Giorgi): 20 ღია კოდის პროექტი git.ge-ზე, სულ 4,092 ვარსკვლავი; ძირითადად C#, TypeScript; კატეგორიები: .NET, მონაცემები და AI."
    string Summary
    {
        get
        {
            var extra = "";
            if (D.Languages.Count > 0) extra += Site.Strings.Ka("meta.developerLanguages", string.Join(", ", D.Languages.Take(3)));
            if (D.Categories.Count > 0)
                extra += Site.Strings.Ka("meta.developerCategories", string.Join(", ", D.Categories.Take(3).Select(c => Site.Strings.Ka($"cat.{c}"))));
            return Site.Strings.Ka("dev.metaDescription", D.DisplayName, D.Login,
                Format.Number(D.Projects.Count + D.Smaller.Count), Format.Number(D.Stars), extra);
        }
    }

    // Unique even when two people share a display name: the login is part of it.
    string PageTitle => D.DisplayName.Equals(D.Login, StringComparison.OrdinalIgnoreCase) ? $"@{D.Login}" : $"{D.DisplayName} (@{D.Login})";

    IReadOnlyList<(string Name, string Path)> Crumbs => [(Site.Strings.Ka("devs.title"), "/developers/"), (D.DisplayName, D.Path)];
}
