<Project Sdk="Microsoft.NET.Sdk.Razor">

  <!-- Renders _build/site-data.json (from `gitge.cs prepare`) into static HTML in _site/.
       Razor components are rendered with HtmlRenderer; no web server is involved
       except for the optional local preview (the serve command). -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>GitGe.Site</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Markdig" Version="1.4.0" />
  </ItemGroup>

</Project>
