@* A medal for a top-three category rank: a disc in gold, silver or bronze with the
   place on it, under a ribbon. Drawn, not an emoji, so it looks the same everywhere.
   Decorative: the rank sentence beside it says the place in words. *@
@if (Rank is >= 1 and <= 3)
{
    <svg class="medal medal-@Rank" viewBox="0 0 32 40" width="@Size" height="@(Size * 40 / 32)" aria-hidden="true" focusable="false">
        <path class="medal-ribbon" d="M7 0h7l5 14h-7zM25 0h-7l-5 14h7z" />
        <circle class="medal-disc" cx="16" cy="26" r="12" />
        <circle class="medal-rim" cx="16" cy="26" r="9" />
        <text class="medal-n" x="16" y="30.5" text-anchor="middle">@Rank</text>
    </svg>
}

@code {
    [Parameter, EditorRequired] public int Rank { get; set; }
    [Parameter] public int Size { get; set; } = 24;
}
