@* One category-rank sentence, e.g. "EntityFramework.Exceptions: ვარსკვლავებით
   პირველი კატეგორიაში „.NET“ (53 პროექტიდან)". Both languages are rendered and
   CSS shows the one matching <html lang>, because the sentence holds links and an
   ordinal that differs per language. Template: i18n "dev.rankLine" with
   {0} project, {1} ordinal, {2} category, {3} count. *@
@foreach (var lang in new[] { "ka", "en" })
{
    var parts = Parts(lang).ToList();
    <span class="l10n" lang="@lang">
        @* The project and its colon in one span, the rest in another, so a list of
           ranks can set the names in a column and line up the sentences after them. *@
        <span class="rank-name"><a href="@Project.Url" rel="@(Project.IsSubmittedUrl ? "nofollow ugc" : null)">@Project.Name</a>@NameSuffix(parts)</span>
        <span class="rank-rest">
        @foreach (var part in Rest(parts))
        {
            @switch (part)
            {
                case "{1}":
                    @if (Strong)
                    {
                        <strong>@(lang == "ka" ? Format.OrdinalKa(R.Rank) : Format.OrdinalEn(R.Rank))</strong>
                    }
                    else
                    {
                        @(lang == "ka" ? Format.OrdinalKa(R.Rank) : Format.OrdinalEn(R.Rank))
                    }
                    break;
                case "{2}":
                    <a href="/c/@R.Category/">@if (Strong) { <strong>@CategoryName(lang)</strong> } else { @CategoryName(lang) }</a>
                    break;
                case "{3}":
                    @Format.Number(R.Of)
                    break;
                default:
                    @part
                    break;
            }
        }
        </span>
    </span>
}

@code {
    [Parameter, EditorRequired] public SiteRank R { get; set; } = default!;
    // The developer's top ranks: ordinal and category in bold.
    [Parameter] public bool Strong { get; set; }

    SiteProject Project => Site.Project(R.Project);

    string CategoryName(string lang) =>
        (lang == "ka" ? Site.Strings.Georgian : Site.Strings.English)[$"cat.{R.Category}"];

    // Both templates start "{0}: …". The ":" stays with the name; the rest follows.
    static string NameSuffix(List<string> parts) =>
        parts.Count > 1 && parts[0] == "{0}" && parts[1].StartsWith(':') ? ":" : "";

    static IEnumerable<string> Rest(List<string> parts)
    {
        if (parts.Count == 0 || parts[0] != "{0}") return parts;
        var rest = parts.Skip(1).ToList();
        if (rest.Count > 0 && rest[0].StartsWith(':')) rest[0] = rest[0][1..].TrimStart();
        return rest.Where(p => p.Length > 0);
    }

    IEnumerable<string> Parts(string lang) =>
        System.Text.RegularExpressions.Regex.Split(
            (lang == "ka" ? Site.Strings.Georgian : Site.Strings.English)["dev.rankLine"], @"(\{[0-3]\})")
        .Where(p => p.Length > 0);
}
