@* The filter sidebar shared by /developers/ and /help-wanted/: filter lists in a narrow
   left column beside the content. A toolbar spans both columns above them: the
   "ფილტრები" button with a panel-left icon that shows or hides the column (it never
   moves), the active filters as removable tags while the column is hidden, an optional
   sort control and the result ("5 დეველოპერი · გასუფთავება"). Two arrangements: with a
   sort control (/developers/) the result is right-aligned after the sort links; Inline
   (/help-wanted/, no sort) keeps everything left-aligned in reading order: the button,
   the result ("106 issue · 52 პროექტი"), then the tags. On desktop the column starts
   hidden and the choice is remembered per page (localStorage, StorageKey). On narrow
   screens the button opens the lists as a panel above the content. Without JavaScript
   the button, the lists and the sort are hidden: just the content.

   app.js reads the data-* attributes: which elements are filtered (Items), which facets
   exist (Facets: cat, lang, label), the result line's string keys, and the storage key.
   Each filtered element carries its values as data-cats / data-langs / data-labels;
   elements marked data-filter-group (e.g. a project section) hide when nothing inside
   them matches. *@
<div class="dev-filters devs-layout@(Inline ? " devs-inline" : null)" data-filter-for="@FilterFor" data-items="@Items" data-facets="@Facets"
     data-storage-key="@StorageKey" data-count-key="@CountKey" data-count-one-key="@CountOneKey"
     data-group-key="@GroupKey" data-group-one-key="@GroupOneKey">
    <div class="devs-topbar">
        <button type="button" class="devs-toggle" hidden aria-expanded="false" aria-controls="devs-filter-panel">
            <svg class="devs-toggle-icon" viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" focusable="false">
                <rect class="devs-toggle-pane" x="3.75" y="4.75" width="5.5" height="14.5" rx="1" />
                <rect x="3" y="4" width="18" height="16" rx="2.5" fill="none" stroke="currentColor" stroke-width="1.5" />
                <path d="M9.75 4.5v15" stroke="currentColor" stroke-width="1.5" />
            </svg>
            <span class="devs-toggle-text"><T K="devs.filters" /></span>
            <span class="devs-toggle-badge" hidden></span>
        </button>
        @if (Inline)
        {
            <DevFilterStatus />
            <span class="devs-tags"></span>
        }
        else
        {
            <span class="devs-tags"></span>
            @Sort
            <DevFilterStatus />
        }
    </div>
    <div class="devs-side" id="devs-filter-panel" hidden>
        <div class="devs-panel-head">
            <strong><T K="devs.filters" /></strong>
            <button type="button" class="devs-panel-close" data-panel-close><svg class="icon-x" viewBox="0 0 12 12" aria-hidden="true" focusable="false"><path d="M3 3l6 6M9 3L3 9" /></svg><span class="visually-hidden"><T K="devs.closeFilters" /></span></button>
        </div>
        @Lists
        <button type="button" class="devs-panel-done" data-panel-close><T K="devs.done" /></button>
    </div>
    <div class="devs-main">
        <p class="note dev-filter-empty" hidden><T K="@EmptyKey" /></p>
        @ChildContent
    </div>
</div>

@code {
    // Id of the element that contains the filtered items.
    [Parameter, EditorRequired] public string FilterFor { get; set; } = "";
    // CSS selector of the filtered items inside it.
    [Parameter, EditorRequired] public string Items { get; set; } = "";
    // Comma-separated facet kinds, in the order of the lists: "cat,lang" or "cat,lang,label".
    [Parameter, EditorRequired] public string Facets { get; set; } = "";
    [Parameter, EditorRequired] public string StorageKey { get; set; } = "";
    // Result line: CountKey with {0} = matching items (CountOneKey for exactly 1); with
    // GroupKey, " · " and the visible groups (data-filter-group) after it, GroupOneKey for 1.
    [Parameter, EditorRequired] public string CountKey { get; set; } = "";
    [Parameter] public string? CountOneKey { get; set; }
    [Parameter] public string? GroupKey { get; set; }
    [Parameter] public string? GroupOneKey { get; set; }
    // Left-aligned toolbar for pages without a sort control (see above).
    [Parameter] public bool Inline { get; set; }
    [Parameter, EditorRequired] public string EmptyKey { get; set; } = "";
    [Parameter, EditorRequired] public RenderFragment? Lists { get; set; }
    [Parameter] public RenderFragment? Sort { get; set; }
    [Parameter, EditorRequired] public RenderFragment? ChildContent { get; set; }
}
