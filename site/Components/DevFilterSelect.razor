@* A labelled <select> for one directory filter (Kind "cat" or "lang"). Options carry
   data-kind, data-value and data-count (the developer count with no other filter
   active); app.js rewrites their text with live counts and disables empty ones. *@
<label class="dev-select">
    <span class="dev-select-label"><T K="@(Kind == "cat" ? "devs.filterCategory" : "devs.filterLanguage")" /></span>
    <select data-filter="@Kind">
        <option value="" data-kind="@Kind" data-value="" data-count="@Total" selected>@Site.Strings.Ka("devs.filterAll")</option>
        @foreach (var (value, label, count) in Options)
        {
            <option value="@value" data-kind="@Kind" data-value="@value" data-count="@count">@label (@count)</option>
        }
    </select>
</label>

@code {
    [Parameter, EditorRequired] public string Kind { get; set; } = "cat";
    [Parameter, EditorRequired] public IEnumerable<(string Value, string Label, int Count)> Options { get; set; } = [];
    [Parameter, EditorRequired] public int Total { get; set; }
}
