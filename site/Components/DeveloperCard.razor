@* One card in the /u/ directory. data-* feed app.js's sort; each .m-* line is the
   metric for one sort, and CSS shows the one matching the directory's data-metric
   (the default line without JavaScript). *@
<li class="dev-cell" data-name="@D.DisplayName.ToLowerInvariant()" data-projects="@Projects" data-followed="@Followers"
    data-pushed="@Format.Date(D.LastPush)" data-first="@D.FirstSeenAt" data-stars="@D.Stars">
    <a class="dev-card" href="@D.Path">
        <Avatar Login="@D.Login" Size="36" />
        <span class="dev-card-text">
            <strong>@D.DisplayName</strong>
            <span class="dev-card-login">@D.Login</span>
            <span class="dev-card-meta m-default" title="@DefaultMeta" data-title-from-text><T K="devs.projects" Args="@([Projects])" />@foreach (var c in D.Categories.Take(2))
                {<span> · </span><T K="@($"cat.{c}")" />}</span>
            <span class="dev-card-meta m-followed"><T K="devs.metricFollowed" Args="@([Followers])" /></span>
            <span class="dev-card-meta m-pushed"><T K="devs.metricPushed" Args="@([Format.Date(D.LastPush) is { Length: > 0 } p ? p : "—"])" /></span>
            <span class="dev-card-meta m-first"><T K="devs.metricFirst" Args="@([D.FirstSeenAt ?? "—"])" /></span>
        </span>
    </a>
</li>

@code {
    [Parameter, EditorRequired] public SiteDeveloper D { get; set; } = default!;

    int Projects => D.Projects.Count + D.Smaller.Count;
    int Followers => D.Mutual.Count + D.FollowedBy.Count;

    // The meta line is one line with an ellipsis, so the full text also goes in the
    // title (Georgian here; app.js copies the visible text after a language switch).
    string DefaultMeta => string.Join(" · ",
        new[] { Site.Strings.Ka("devs.projects", Projects) }
            .Concat(D.Categories.Take(2).Select(c => Site.Strings.Ka($"cat.{c}"))));
}
