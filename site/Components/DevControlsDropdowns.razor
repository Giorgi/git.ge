@* Layout "dropdowns": one toolbar row of native selects — category, language, sort —
   then the result count and clear link on the right. Hidden without JavaScript. *@
<div class="dev-filters dev-controls" hidden data-filter-for="devs-dir">
    <div class="sort dev-toolbar" data-sort-for="devs" data-groups="devs-more" data-group-sort="name">
        <DevFilterSelect Kind="cat" Options="@Categories" Total="@Developers.Count" />
        <DevFilterSelect Kind="lang" Options="@Languages" Total="@Developers.Count" />
        <DevSortSelect Developers="@Developers" />
        <DevFilterStatus />
    </div>
</div>

@code {
    [Parameter, EditorRequired] public List<SiteDeveloper> Developers { get; set; } = [];

    IEnumerable<(string, string, int)> Categories => DeveloperFilters.CategoryOptions(Developers);
    IEnumerable<(string, string, int)> Languages => DeveloperFilters.LanguageOptions(Developers);
}
