@* A row of linked avatars (mutual follows, followers, following): a heading with
   the count, up to Max avatars, then "and N more". Hidden when empty. *@
@if (Logins.Count > 0)
{
    <div class="people">
        <p class="people-text"><T K="@TextKey" Args="@([Logins.Count])" /></p>
        <ul class="people-list">
            @foreach (var login in Logins.Take(Max))
            {
                var dev = Site.Developer(login);
                <li>
                    <a href="@Site.OwnerHref(login)" title="@(dev?.DisplayName ?? login)">
                        <Avatar Login="@login" Size="36" />
                    </a>
                </li>
            }
            @if (Logins.Count > Max)
            {
                <li class="people-more"><T K="dev.andMore" Args="@([Logins.Count - Max])" /></li>
            }
        </ul>
    </div>
}

@code {
    [Parameter, EditorRequired] public List<string> Logins { get; set; } = [];
    [Parameter, EditorRequired] public string TextKey { get; set; } = "";
    [Parameter] public int Max { get; set; } = 12;
}
