@* Sort order for the developer directory as a <select> (app.js handles "change").
   "New on git.ge" is left out while every developer shares the same first-seen
   date (right after launch it sorts nothing). *@
<label class="dev-select">
    <span class="dev-select-label"><T K="sort.label" /></span>
    <select data-sort-select>
        @foreach (var (key, label) in Options)
        {
            <option value="@key" data-i18n="@label" selected="@(key == "name")">@Site.Strings.Ka(label)</option>
        }
    </select>
</label>

@code {
    [Parameter, EditorRequired] public List<SiteDeveloper> Developers { get; set; } = [];

    static readonly (string Key, string Label)[] All =
    [
        ("name", "sort.name"),
        ("projects", "sort.projects"),
        ("followed", "sort.followed"),
        ("pushed", "sort.recent"),
        ("first", "sort.firstSeen"),
    ];

    IEnumerable<(string Key, string Label)> Options =>
        All.Where(o => o.Key != "first" || DeveloperFilters.ShowFirstSeenSort(Developers));
}
