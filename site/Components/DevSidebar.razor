@* Layout "sidebar": the category and language lists in a narrow left column beside the
   grid. A toolbar spans both columns above them: a panel-left icon button that shows
   or hides the column (it never moves), the active filters as removable tags while the
   column is hidden, the sort links and the result ("5 დეველოპერი · გასუფთავება").
   On desktop the column starts hidden and the choice is remembered (localStorage). On
   narrow screens the button also says "ფილტრები" and opens the lists as a panel above
   the grid. Without JavaScript the button, the lists and the sort are hidden: just the grid. *@
<div class="dev-filters devs-layout" data-filter-for="devs-dir" data-count-always>
    <div class="devs-topbar">
        <button type="button" class="devs-toggle" hidden aria-expanded="false" aria-controls="devs-filter-panel">
            <svg class="devs-toggle-icon" viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" focusable="false">
                <rect class="devs-toggle-pane" x="3.75" y="4.75" width="5.5" height="14.5" rx="1" />
                <rect x="3" y="4" width="18" height="16" rx="2.5" fill="none" stroke="currentColor" stroke-width="1.5" />
                <path d="M9.75 4.5v15" stroke="currentColor" stroke-width="1.5" />
            </svg>
            <span class="devs-toggle-text"><T K="devs.filters" /></span>
            <span class="devs-toggle-badge" hidden></span>
        </button>
        <span class="devs-tags"></span>
        <DevSortLinks Developers="@Developers" />
        <DevFilterStatus />
    </div>
    <div class="devs-side" id="devs-filter-panel" hidden>
        <div class="devs-panel-head">
            <strong><T K="devs.filters" /></strong>
            <button type="button" class="devs-panel-close" data-panel-close><svg class="icon-x" viewBox="0 0 12 12" aria-hidden="true" focusable="false"><path d="M3 3l6 6M9 3L3 9" /></svg><span class="visually-hidden"><T K="devs.closeFilters" /></span></button>
        </div>
        <DevFacet Kind="cat" TitleKey="devs.facetCategory" Options="@DeveloperFilters.CategoryOptions(Developers).ToList()" Total="@Developers.Count" />
        <DevFacet Kind="lang" TitleKey="devs.facetLanguage" Options="@DeveloperFilters.LanguageOptions(Developers).ToList()" Total="@Developers.Count" Top="12" />
        <button type="button" class="devs-panel-done" data-panel-close><T K="devs.done" /></button>
    </div>
    <div class="devs-main">
        <p class="note dev-filter-empty" hidden><T K="devs.noMatch" /></p>
        @ChildContent
    </div>
</div>

@code {
    [Parameter, EditorRequired] public List<SiteDeveloper> Developers { get; set; } = [];
    [Parameter, EditorRequired] public RenderFragment? ChildContent { get; set; }
}
