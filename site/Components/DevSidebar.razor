@* Filters for the developer directory: category and language, on the shared sidebar
   (FilterSidebar), with the sort links in its toolbar. Counts are developers. *@
<FilterSidebar FilterFor="devs-dir" Items="li[data-cats]" Facets="cat,lang" StorageKey="gitge.devSidebar"
               CountKey="devs.filterCount" CountOneKey="devs.filterCountOne" EmptyKey="devs.noMatch">
    <Lists>
        <DevFacet Kind="cat" TitleKey="devs.facetCategory" Options="@DeveloperFilters.CategoryOptions(Developers).ToList()" Total="@Developers.Count" />
        <DevFacet Kind="lang" TitleKey="devs.facetLanguage" Options="@DeveloperFilters.LanguageOptions(Developers).ToList()" Total="@Developers.Count" Top="12" />
    </Lists>
    <Sort>
        <DevSortLinks Developers="@Developers" />
    </Sort>
    <ChildContent>
        @ChildContent
    </ChildContent>
</FilterSidebar>

@code {
    [Parameter, EditorRequired] public List<SiteDeveloper> Developers { get; set; } = [];
    [Parameter, EditorRequired] public RenderFragment? ChildContent { get; set; }
}
